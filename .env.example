# =============================================================================
# AI Parking Central Backend - Environment Configuration
# Copy this file to .env and fill in your values
# =============================================================================

# --- App ---
APP_NAME=AI Parking Central
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0
APP_HOST=0.0.0.0
APP_PORT=8000
APP_WORKERS=1
APP_LOG_LEVEL=DEBUG
APP_SECRET_KEY=change-me-to-a-random-secret-key
APP_ALLOWED_HOSTS=["*"]
APP_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=ai_parking
DB_PASSWORD=ai_parking_pass
DB_NAME=ai_parking_central
DB_ECHO=false
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# --- JWT Auth ---
JWT_SECRET_KEY=change-me-to-a-random-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- MQTT ---
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=myuser
MQTT_PASSWORD=Broker@123
MQTT_CLIENT_ID=central-server
MQTT_KEEPALIVE=60
MQTT_QOS=1

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Firebase (FCM Push Notifications) ---
FIREBASE_CREDENTIALS_PATH=
FIREBASE_PROJECT_ID=

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@aiparking.com
SMTP_FROM_NAME=AI Parking
SMTP_TLS=true

# --- Docker Registry (for OTA) ---
DOCKER_REGISTRY_URL=
DOCKER_REGISTRY_USER=
DOCKER_REGISTRY_PASSWORD=

# --- Logging ---
LOG_FORMAT=json
LOG_FILE_PATH=logs/app.log
LOG_ROTATION=10 MB
LOG_RETENTION=30 days

# --- Pagination ---
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# --- Device Heartbeat ---
DEVICE_HEARTBEAT_INTERVAL_SECONDS=30
DEVICE_OFFLINE_THRESHOLD_SECONDS=300

# --- Vehicle Counter (standalone SQLite, stored in the ./data bind mount) ---
VEHICLE_COUNTER_DB_PATH=data/vehicle_counter/vehicle_log.db
VEHICLE_COUNTER_ENABLED=true
